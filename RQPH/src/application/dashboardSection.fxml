<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="dashboardAnchor" prefHeight="500.0" prefWidth="800.0" stylesheets="@application.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.DashboardController">
	<children>
		<!-- Navbar Section -->
		<Rectangle fx:id="navBar" height="46.0" layoutY="0.0" width="800.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />

		<!-- Logo Section -->
		<Label fx:id="logoLabel" layoutX="14.0" layoutY="9.0" text="ResquePH">
			<font>
				<Font name="System Bold" size="12.0" />
			</font>
		</Label>

		<!-- Date & Time Section -->
		<Label fx:id="dateTimeLabel" layoutX="616.0" layoutY="9.0" text="00/00/0000 00:00:00">
			<font>
				<Font name="Roboto" />
			</font>
		</Label>

      		<!-- Sidebar Section -->
		<Rectangle fx:id="sideBar" height="454.0" layoutY="51.0" width="180.0" AnchorPane.bottomAnchor="0.0" />
      <Hyperlink fx:id="openPatient" layoutX="45.0" layoutY="180.0" text="Patient's Info" textFill="WHITE">
         <font>
            <Font size="14.0" />
         </font>
      </Hyperlink>
      <Hyperlink fx:id="backupReset" layoutX="45.0" layoutY="370.0" text="Backup &amp; Reset" textFill="WHITE">
         <font>
            <Font size="14.0" />
         </font>
      </Hyperlink>
      <Hyperlink fx:id="openQueue" layoutX="45.0" layoutY="241.0" text="Queue Display" textFill="WHITE">
         <font>
            <Font size="14.0" />
         </font>
      </Hyperlink>
      <Hyperlink fx:id="dashboard" layoutX="45.0" layoutY="306.0" text="Dashboard" textFill="WHITE">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Hyperlink>
      <Hyperlink fx:id="logOut" layoutX="45.0" layoutY="434.0" text="Logout" textFill="WHITE">
         <font>
            <Font size="14.0" />
         </font>
	  </Hyperlink>
	  <ImageView fx:id="logoImage" fitHeight="56.0" fitWidth="58.0" layoutX="61.0" layoutY="84.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@RQPH.png" />
               </image>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
      </ImageView>
      <ImageView fitHeight="27.0" fitWidth="32.0" layoutX="14.0" layoutY="179.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@icons8-note-48.png" />
               </image>
            </ImageView>
            <ImageView fitHeight="23.0" fitWidth="23.0" layoutX="16.0" layoutY="308.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@icons8-dashboard-50.png" />
               </image>
            </ImageView>
            <ImageView fitHeight="27.0" fitWidth="32.0" layoutX="14.0" layoutY="370.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@icons8-sync-64.png" />
               </image>
            </ImageView>
            <ImageView fitHeight="23.0" fitWidth="48.0" layoutX="18.0" layoutY="435.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@icons8-exit-30.png" />
               </image>
            </ImageView>
            <ImageView fitHeight="34.0" fitWidth="39.0" layoutX="11.0" layoutY="234.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@icons8-queue-64.png" />
               </image>
            </ImageView>
	  
		<!-- Dashboard (Main Contents) -->
		<VBox fx:id="totalWaitingContainer" layoutX="195.0" layoutY="55.0" prefHeight="60.0" prefWidth="140.0">
			<children>
				<Label fx:id="totalWaiting" text="TOTAL WAITING">
					<font>
						<Font name="Roboto" />
					</font>
				</Label>
				<Label fx:id="totalWaitingRecords" text="0">
					<font>
						<Font name="Roboto" />
					</font>
				</Label>
			</children>
		</VBox>

		<VBox fx:id="totalServedContainer" layoutX="344.0" layoutY="55.0" prefHeight="60.0" prefWidth="140.0">
			<children>
				<Label fx:id="totalServed" text="TOTAL SERVED">
					<font>
						<Font name="Roboto" />
					</font>
				</Label>
				<Label fx:id="totalServedRecords" text="0">
					<font>
						<Font name="Roboto" />
					</font>
				</Label>
			</children>
		</VBox>

		<VBox fx:id="averageWaitingContainer" layoutX="496.0" layoutY="55.0" prefHeight="60.0" prefWidth="140.0">
			<children>
				<Label fx:id="averageWaiting" text="AVERAGE WAITING">
					<font>
						<Font name="Roboto" />
					</font>
				</Label>
				<Label fx:id="averageWaitingRecords" text="00:00:00">
					<font>
						<Font name="Roboto" />
					</font>
				</Label>
			</children>
		</VBox>

		<VBox fx:id="longestWaitContainer" layoutX="645.0" layoutY="55.0" prefHeight="60.0" prefWidth="140.0">
			<children>
				<Label fx:id="longestWait" text="LONGEST WAIT">
					<font>
						<Font name="Roboto" />
					</font>
				</Label>
				<Label fx:id="longestWaitRecords" text="00:00:00">
					<font>
						<Font name="Roboto" />
					</font>
				</Label>
			</children>
		</VBox>

		<!-- Triage Level Container -->
		<VBox fx:id="triageLevelContainer" layoutX="195.0" layoutY="124.0" prefHeight="333.0" prefWidth="590.0">
			<Label fx:id="patientCountTL" text="Patient Count">
				<font>
					<Font name="Roboto" />
				</font>
			</Label>

			<VBox spacing="10">

				<padding>
					<Insets bottom="0" left="0" right="0" top="10" />
				</padding>

				<HBox>
					<StackPane>
						<Circle fx:id="triageLevel1" radius="16.0" />
						<Label fx:id="l1" text="L1" />
					</StackPane>
					<VBox spacing="1">
						<Label fx:id="resuscitation" text="Resuscitation">
							<font>
								<Font name="Roboto" />
							</font>
						</Label>
						<ProgressBar fx:id="progressBarL1" prefWidth="500" progress="0.0" />
					</VBox>
					<Label fx:id="resuscitationRecords" text="0">
						<font>
							<Font name="Roboto" />
						</font>
					</Label>
				</HBox>
				<HBox>
					<StackPane>
						<Circle fx:id="triageLevel2" radius="16.0" />
						<Label fx:id="l2" text="L2" />
					</StackPane>
					<VBox spacing="1">
						<Label fx:id="emergent" text="Emergent">
							<font>
								<Font name="Roboto" />
							</font>
						</Label>
						<ProgressBar fx:id="progressBarL2" prefWidth="500" progress="0.0" />
					</VBox>
					<Label fx:id="emergentRecords" text="0">
						<font>
							<Font name="Roboto" />
						</font>
					</Label>
				</HBox>
				<HBox>
					<StackPane>
						<Circle fx:id="triageLevel3" radius="16.0" />
						<Label fx:id="l3" text="L3" />
					</StackPane>
					<VBox spacing="1">
						<Label fx:id="urgent" text="Urgent">
							<font>
								<Font name="Roboto" />
							</font>
						</Label>
						<ProgressBar fx:id="progressBarL3" prefWidth="500" progress="0.0" />
					</VBox>
					<Label fx:id="urgentRecords" text="0">
						<font>
							<Font name="Roboto" />
						</font>
					</Label>
				</HBox>
				<HBox>
					<StackPane>
						<Circle fx:id="triageLevel4" radius="16.0" />
						<Label fx:id="l4" text="L4" />
					</StackPane>
					<VBox spacing="1">
						<Label fx:id="lessUrgent" text="Less Urgent">
							<font>
								<Font name="Roboto" />
							</font>
						</Label>
						<ProgressBar fx:id="progressBarL4" prefWidth="500" progress="0.0" />
					</VBox>
					<Label fx:id="lessUrgentRecords" text="0">
						<font>
							<Font name="Roboto" />
						</font>
					</Label>
				</HBox>
				<HBox>
					<StackPane>
						<Circle fx:id="triageLevel5" radius="16.0" />
						<Label fx:id="l5" text="L5" />
					</StackPane>
					<VBox spacing="1">
						<Label fx:id="nonUrgent" text="Non-Urgent">
							<font>
								<Font name="Roboto" />
							</font>
						</Label>
						<ProgressBar fx:id="progressBarL5" prefWidth="500" progress="0.0" />
					</VBox>
					<Label fx:id="nonUrgentRecords" text="0">
						<font>
							<Font name="Roboto" />
						</font>
					</Label>
				</HBox>
				<HBox>
					<StackPane>
						<Circle fx:id="regular" radius="16.0" />
						<Label fx:id="r" text="R" />
					</StackPane>
					<VBox spacing="1">
						<Label fx:id="reg" text="Regular">
							<font>
								<Font name="Roboto" />
							</font>
						</Label>
						<ProgressBar fx:id="progressBarRegular" prefWidth="500" progress="0.0" />
					</VBox>
					<Label fx:id="regularRecords" text="0">
						<font>
							<Font name="Roboto" />
						</font>
					</Label>
				</HBox>

				<Rectangle fx:id="breakLine" height="1" width="555" />

      				<HBox prefHeight="7.0" prefWidth="571.0">
					<Label fx:id="totalPatients" text="Total Patients">
						<font>
							<Font name="Roboto" />
						</font>
					</Label>
					<Label fx:id="totalPatientsRecords" text="0">
						<font>
							<Font name="Roboto" />
						</font>
					</Label>
				</HBox>
			</VBox>
		</VBox>

		<!-- System Status Container -->
		<HBox fx:id="systemStatusContainer" alignment="CENTER_LEFT" layoutX="195.0" layoutY="465.0" prefHeight="30.0" prefWidth="590.0" spacing="5">
			<Label fx:id="systemStatus" text="System Status">
				<font>
					<Font name="Roboto" />
				</font>
			</Label>
   			
   			<!-- Spacer to push right side -->
   			<Region HBox.hgrow="ALWAYS" />
			
			<HBox alignment="CENTER_RIGHT" spacing="5">
   				<Circle fx:id="statusIndicator" radius="4" />
   				<Label fx:id="systemStatusIndicator" text="Online">
   					<font>
   						<Font name="Roboto" />
   					</font>
   				</Label>
			</HBox>
		</HBox>
	</children>
</AnchorPane>